{
  "name": "games-of-the-pigeon-god",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/version.mjs && tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "simulate": "node scripts/run-simulation.mjs",
    "test:api": "node --test backend/*.check.mjs",
    "test:telemetry": "node scripts/verify-telemetry.mjs",
    "build:api": "node scripts/build-api.mjs",
    "export:players": "node scripts/export-data.mjs players",
    "export:analytics": "node scripts/export-data.mjs analytics"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
